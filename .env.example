APP_HOST=127.0.0.1
APP_PORT=4317
DATA_DIR=.data
GITHUB_TOKEN=
# Optional administrator-provided PEM CA bundle for a verified enterprise TLS
# proxy. Keep certificate verification enabled; never point this at a leaf
# certificate copied from an unverified connection.
RADAR_GITHUB_CA_FILE=
III_URL=ws://127.0.0.1:49134
# Fill secrets locally, then restart the application. Never paste them into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default: verified zero-priced OpenCode models, then existing local Codex configuration.
# Codex costs depend on that configuration. DeepSeek requires explicit mode selection.
ANALYSIS_PROVIDER=local
# Optional when auto-detection finds your desktop CLI. Quote paths containing spaces.
OPENCODE_BIN=
OPENCODE_MODEL=opencode/glm-5.3-flash-free
# Optional if desktop CLI and top-level Codex model config are auto-detected.
CODEX_BIN=
CODEX_MODEL=
